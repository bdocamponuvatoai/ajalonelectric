# Copy to .env.local for local overrides. Both values are read at build time.

# Public origin for canonical URLs, Open Graph tags, robots.txt and sitemap.xml.
# No trailing slash needed. When unset on Vercel, the project's production
# domain (VERCEL_PROJECT_PRODUCTION_URL) is used; locally, http://localhost:3000.
SITE_URL=https://www.example.com

# Let search engines index the site. Keep "false" until the business owner has
# approved the content and launch. "true" requires a real SITE_URL.
SITE_INDEXABLE=false
